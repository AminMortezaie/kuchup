# Flask session signing (set in production)
PANEL_SECRET_KEY=change-me-to-a-long-random-string

# Google OAuth (required for panel + MCP sign-in)
# Create a Web client in Google Cloud Console; add authorized redirect URI(s):
#   https://kuchup.com/api/auth/google/callback
#   http://127.0.0.1:5051/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (defaults to {request origin}/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=https://kuchup.com/api/auth/google/callback

# Admin Google accounts (comma-separated emails). These users get is_admin on sign-in.
PANEL_ADMIN_EMAILS=you@gmail.com
# Legacy username still used by the fetch scheduler when resolving an admin user id
PANEL_ADMIN_USER=admin

# Secure cookies in production (HTTPS) — required on kuchup.com; deploy sets this.
SESSION_COOKIE_SECURE=1

# Public panel base URL (MCP OAuth login links back here for Google)
# PANEL_PUBLIC_BASE_URL=https://kuchup.com

# SQLite path (default: data/panel.db locally) — ignored when DATABASE_URL is set
# PANEL_DATA_DIR=data
# PANEL_DB_PATH=data/panel.db

# Postgres (required in production). Schema via init_db() on startup.
# Migrate from Neon: scripts/aws_postgres_migrate.sh (see docs/operations/aws-postgres.md)
#
# Neon (pooler for serverless; use direct host for pg_dump):
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# AWS EC2 Docker (Scenario A — local scrape + Render; open 5432 for Render egress):
# DATABASE_URL=postgresql://relocation:PASSWORD@<ELASTIC_IP>:5432/relocation_jobs?sslmode=prefer
#
# AWS RDS (Scenario B):
# DATABASE_URL=postgresql://relocation:PASSWORD@your-instance.region.rds.amazonaws.com:5432/relocation_jobs?sslmode=require
#
# Local dev (fast iteration):
# DATABASE_URL=postgresql://localhost:5432/relocation_jobs

# Redis on EC2 (country registry pilot — see scripts/ec2_redis.sh):
# REDIS_URL=redis://:PASSWORD@<ELASTIC_IP>:6379/0
# When set, country labels are stored in Redis hash countries:labels (shared Render + local).
# Postgres custom_countries remains fallback when REDIS_URL is unset (tests/local).

# AWS CLI (optional — for scripts/aws_postgres_migrate.sh; gitignored via .env)
# Run sync-sg after your public IP changes (fixes SSH/Postgres lockout):
#   ./scripts/aws_postgres_migrate.sh sync-sg
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1

# Cloudflare API token (Email Routing + DNS for kuchup.com — see docs/operations/email.md)
# Custom token permissions:
#   Account → Email Routing Addresses → Edit
#   Zone → Email Routing Rules → Edit
#   Zone → DNS → Edit
#   Zone → Zone → Read
#   Zone → Zone Settings → Edit   # required to enable Email Routing DNS via API
# Scoped to account + zone kuchup.com
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=kuchup.com
# Destination Gmail for hello@ / support@ forwards (not committed):
# CLOUDFLARE_EMAIL_DESTINATION=you@gmail.com

# Disable in-browser scraping (default on Render free — 512MB RAM)
# PANEL_SCRAPE_ENABLED=0
# Enable single-company Fetch jobs on the panel without country scrape (EC2 panel):
# PANEL_COMPANY_FETCH_ENABLED=1

# Fetch scheduler timeouts (EC2 worker — see docs/reference/fetch-scheduler-timeout-practices.md)
# FETCH_COMPANY_TIMEOUT_SECONDS=300
# FETCH_COUNTRY_TIMEOUT_SECONDS=2700
# PLAYWRIGHT_BOARD_TIMEOUT_SECONDS=90

# Allow self-service Google registration after the first user exists
# PANEL_ALLOW_REGISTER=1

# Entitlements — free vs full access (NOWPayments checkout for packs + Full Access)
# FREE_BOARD_COMPANY_CAP=10
# FREE_JOBS_PER_COMPANY=3
# Unique explicit job actions per UTC calendar month
# FREE_TOTAL_POSITION_BUDGET=30

# Credit / Full Access checkout (NOWPayments). Production uses live API unless
# NOWPAYMENTS_SANDBOX=1. IPN callback is https://kuchup.com/api/payments/nowpayments/ipn
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX=1
# FREE_MCP_DAILY_REQUESTS=20
# FULL_MCP_DAILY_REQUESTS=500
# (0 = unlimited for full-plan MCP daily)
# Unique public /jobs/{slug}/save actions per UTC day before credits
# FREE_PUBLIC_JOB_SAVES_PER_DAY=3

# LinkedIn Basic Jobs XML feed (GET /feeds/linkedin-jobs.xml). Numeric company Page id
# from the Page admin URL; poster email for LinkedIn Jobs Trust & Safety.
# LINKEDIN_COMPANY_ID=
# LINKEDIN_JOB_POSTER_EMAIL=

# Opportunity refresh queue (Phase E). When unset, refresh runs inline (sync).
# SQS_USER_OPPORTUNITY_REFRESH_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/user-opportunity-refresh
# Worker: python3 scripts/opportunity_sqs_worker.py --once

# Claude Desktop MCP server (scripts/mcp_server.py) — see docs/reference/mcp-application.md
# MCP_USERNAME=admin
# MCP_USER_ID=
# MCP_LATEX_CMD=tectonic

# Remote MCP HTTP + OAuth (scripts/mcp_http_server.py) — Claude / Cursor connectors
# MCP_PUBLIC_BASE_URL=https://mcp.kuchup.com
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=10001

# Grafana Cloud Free (Alloy on EC2 — docs/operations/monitoring.md)
# Access policy / API token needs metrics:write AND logs:write (or a second token).
# Metrics: stack → Prometheus → Send metrics → remote_write URL + user.
# Logs: stack → Loki → Send logs → push URL + user (instance id differs from Prometheus).
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-XX.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=123456
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XX-XX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=123456
# GRAFANA_CLOUD_API_TOKEN=glc_...
