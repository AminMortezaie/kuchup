# syntax=docker/dockerfile:1
# Light EC2 fetch worker: HTTP ATS APIs / HTML only (Greenhouse, Lever, Ashby, …).
# No Playwright, no Chromium. Browser boards use Dockerfile.ec2-worker-playwright.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PANEL_DATA_DIR=/tmp/panel-data \
    PANEL_SCRAPE_ENABLED=1 \
    FETCH_SCHEDULE_ENABLED=1 \
    FETCH_SCHEDULE_INTERVAL_HOURS=6 \
    FETCH_SCHEDULE_CONCURRENCY=4 \
    FETCH_WORKER_KIND=http

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,id=relocation-worker-pip,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY . .

RUN mkdir -p /tmp/panel-data

CMD ["python3", "scripts/fetch_scheduler_worker.py"]
