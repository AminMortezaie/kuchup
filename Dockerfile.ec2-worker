# syntax=docker/dockerfile:1
# Light EC2 fetch worker: Go does HTTP ATS board I/O; Python merges the catalog.
# No browser. Browser boards use Dockerfile.ec2-worker-playwright.
FROM golang:1.25-alpine AS ats-scrape
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY ats_scrape ./ats_scrape
COPY apps/ats-scrape ./apps/ats-scrape
RUN CGO_ENABLED=0 go build -o /out/ats-scrape ./apps/ats-scrape

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PANEL_DATA_DIR=/tmp/panel-data \
    PANEL_SCRAPE_ENABLED=1 \
    FETCH_SCHEDULE_ENABLED=1 \
    FETCH_SCHEDULE_INTERVAL_HOURS=6 \
    FETCH_SCHEDULE_CONCURRENCY=4 \
    FETCH_WORKER_KIND=http \
    ATS_SCRAPE_BIN=/usr/local/bin/ats-scrape \
    FETCH_HTTP_SCRAPE=auto

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,id=relocation-worker-pip,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY . .
COPY --from=ats-scrape /out/ats-scrape /usr/local/bin/ats-scrape

RUN mkdir -p /tmp/panel-data

CMD ["python3", "scripts/fetch_scheduler_worker.py"]
