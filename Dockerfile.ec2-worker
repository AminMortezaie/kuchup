# syntax=docker/dockerfile:1
# HTTP fetch worker: Go scheduler + goroutine pool (static binary only).
# Playwright boards use Dockerfile.ec2-worker-playwright.
FROM golang:1.26-alpine AS build
RUN apk add --no-cache ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY ats_scrape ./ats_scrape
COPY apps/ats-scrape ./apps/ats-scrape
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/fetch-scheduler ./apps/ats-scrape

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /out/fetch-scheduler /fetch-scheduler
ENV FETCH_SCHEDULE_ENABLED=1 \
    FETCH_SCHEDULE_INTERVAL_HOURS=6 \
    FETCH_HTTP_POOL_SIZE=4 \
    FETCH_WORKER_KIND=http
CMD ["/fetch-scheduler"]
