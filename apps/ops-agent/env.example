# Tiny ops metrics agent (replaces Grafana Alloy for Prometheus metrics).
# Deploy passes most values from .env / aws-postgres.env via ec2_app_deploy.sh.
# Copy to deploy/ec2/ops-agent.env on the host only if you run the binary outside Docker.

# Scrape interval (default 60s)
OPS_METRICS_INTERVAL=60s

# Panel blackbox probe (matches ec2 status / Alloy probe)
OPS_HEALTH_URL=http://127.0.0.1:10000/api/health

# Prometheus instance label on exported series
OPS_INSTANCE=kuchup-ec2

# Host paths inside the container (defaults match deploy volume mounts)
OPS_PROC_ROOT=/host/proc
OPS_HOST_ROOT=/host/root
OPS_DOCKER_SOCKET=/var/run/docker.sock

# Optional override; default list includes relocation-* (panel, workers, merge, mcp, caddy,
# propagator, playwright, ops-agent, alloy, redis) + pg
# OPS_CONTAINER_NAMES=relocation-panel,relocation-fetch-worker,relocation-fetch-merge,relocation-mcp,relocation-caddy,relocation-ops-agent,pg

# Postgres permanent samples (same DATABASE_URL as panel)
# DATABASE_URL=postgresql://relocation:PASSWORD@host.docker.internal:5432/relocation_jobs?sslmode=prefer

# Grafana Cloud remote_write (same as former Alloy)
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-XX.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=123456
# GRAFANA_CLOUD_API_TOKEN=glc_...
